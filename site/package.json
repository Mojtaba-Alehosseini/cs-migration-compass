{
  "name": "cs-migration-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Compare 15 countries and 73 cities as migration destinations. We visualize; we never recommend.",
  "scripts": {
    "predev": "npm run data",
    "dev": "vite",
    "data": "python ../scripts/build_site_data.py",
    "prebuild": "npm run data && npm run og",
    "og": "python ../scripts/generate_og_images.py",
    "build": "tsc --noEmit && vite build && npm run share-pages",
    "share-pages": "python ../scripts/generate_share_pages.py",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
