# NOTE: .gitignore has no inline comment syntax. A trailing "# ..." on a pattern
# line becomes part of the pattern and the rule silently matches nothing.
# Keep every comment on its own line.

# dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# build output
site/dist/
site/.vite/
*.tsbuildinfo

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local env
.env
.env.local

# logs
*.log
npm-debug.log*
logs/

# work-order scratch: run status markers and the prompt files that drive them
.status/
prompts/

# ---------------------------------------------------------------------------
# Raw download caches.
#
# Everything under data/raw/ is a cache of a third-party download. It is
# re-created by `make pipeline`, so it is kept on disk but out of the repo:
# the committed artefacts are data/processed/ (the derived outputs) plus
# data/provenance.json (which records exactly where each file came from and
# what was done to it).
# ---------------------------------------------------------------------------
data/raw/*

# EXCEPTION: this one is an INPUT, not a cache. It is the hand-collected
# levels.fyi capture that scripts/src_levels_fyi.py reads to build the
# top-employer salary band. Nothing re-downloads it, so dropping it would make
# that step unreproducible.
!data/raw/levels_fyi/

# EXCEPTION: same reasoning, package 12. The Ashby/Greenhouse/Lever
# candidate-token lists (data/raw/postings_seed_hints/*.json) are the SEED
# HINT input the postings harvesters probe live before trusting anything in
# them — without this exception, a fresh checkout (specifically
# .github/workflows/postings-refresh.yml's own runner) would start every
# scheduled run with zero candidates, silently collapsing the postings
# panel from ~1,200 verified companies down to whatever a handful of
# hand-seeded boards (Teamtailor) provide, then have its own commit step
# fail outright trying to `git add` a path this file still ignored. Found
# live by this package's own adversarial review, not caught before it
# shipped: the workflow had never actually run.
!data/raw/postings_seed_hints/

