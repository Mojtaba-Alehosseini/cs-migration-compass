# NOTE: .gitignore has no inline comment syntax. A trailing "# ..." on a pattern
# line becomes part of the pattern and the rule silently matches nothing.
# Keep every comment on its own line.

# dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# build output
site/dist/
site/.vite/
*.tsbuildinfo

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local env
.env
.env.local

# logs
*.log
npm-debug.log*
logs/

# work-order scratch: run status markers and the prompt files that drive them
.status/
prompts/

# ---------------------------------------------------------------------------
# Raw download caches.
#
# Everything under data/raw/ is a cache of a third-party download. It is
# re-created by `make pipeline`, so it is kept on disk but out of the repo:
# the committed artefacts are data/processed/ (the derived outputs) plus
# data/provenance.json (which records exactly where each file came from and
# what was done to it).
# ---------------------------------------------------------------------------
data/raw/*

# EXCEPTION: this one is an INPUT, not a cache. It is the hand-collected
# levels.fyi capture that scripts/src_levels_fyi.py reads to build the
# top-employer salary band. Nothing re-downloads it, so dropping it would make
# that step unreproducible.
!data/raw/levels_fyi/

